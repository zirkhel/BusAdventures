    "characterLevel": { "incomePerLevel": 0.5, "maxLevel": 5,  "cost": { "seconds": 20, "growth": 1.5 }, "fragments": [1, 3, 5, 10] },
    "upgrade":        { "incomePerLevel": 0.2, "maxLevel": 5,  "cost": { "seconds": 20, "growth": 1.5 }, "fragments": [1, 2, 3] },
    "rarities": {
      "common": { "label": "Common", "incomeShare": 0.5, "unlockFragments": 1, "costFactor": 1, "color": "#8fd694" },
      "rare":   { "label": "Rare",   "incomeShare": 1,   "unlockFragments": 2, "costFactor": 1.5, "color": "#ffd166" },
      "epic":   { "label": "Epic",   "incomeShare": 2,   "unlockFragments": 3, "costFactor": 2, "color": "#ef476f" }
    }
  },
  "booster": { "name": "Day Pass", "draws": 3, "priceSeconds": 20, "minPrice": 5,
    "slotWeights": { "character": 60, "room": 15, "upgrade": 15, "coins": 10 },
    "rarityWeights": { "common": 60, "rare": 30, "epic": 10 }, "coinsSeconds": [10, 30], "epicPity": 8 },
  "presentation": { "sceneAspect": 1.6, "palette": { "bg": "#10161a", "panel": "#18222a", "panel2": "#22303a", "accent": "#06d6a0" }, "fontDisplay": "'Trebuchet MS', sans-serif" },
  "rooms": [
    { "id": "stop", "order": 1, "name": "The Bus Stop", "blurb": "A pole, a sign, a timetable that lies.", "price": 0, "baseIncome": 1,
      "background": { "color": "linear-gradient(#9bd1f5 0 62%, #6c757d 62% 70%, #3d4248 70%)" },
      "characters": [
        { "id": "stop.commuter", "name": "Tired Commuter", "rarity": "common", "bio": "Has waited at this stop every weekday for eleven years. Has hope. Should not.", "sprite": { "char": "🧍", "x": 30, "y": 70, "h": 30, "z": 3 } },
        { "id": "stop.pensioner", "name": "Pensioner with Opinions", "rarity": "rare", "bio": "Knows the timetable by heart and will tell you exactly how wrong it is.", "sprite": { "char": "🧓", "x": 48, "y": 70, "h": 26, "z": 3 } },
        { "id": "stop.stranger", "name": "Man Who Is Always There", "rarity": "epic", "bio": "Always there. Never boards. Nobody remembers him arriving.", "sprite": { "char": "🕴️", "x": 82, "y": 70, "h": 30, "z": 2 } }
      ],
      "upgrades": [
        { "id": "stop.bench", "name": "Bench", "effect": "Sitting is a luxury.", "visual": { "char": "🪑", "x": 64, "y": 70, "h": 18, "z": 1 } },
        { "id": "stop.shelter", "name": "Rain Shelter", "effect": "Mostly keeps the rain off.", "visual": { "x": 15, "y": 70, "h": 45, "z": 1, "stages": [ { "minLevel": 1, "char": "🚏" }, { "minLevel": 3, "char": "🏛️" } ] } },
        { "id": "stop.timetable", "name": "Timetable", "effect": "Optimistic fiction, printed in two languages.", "visual": { "char": "🗓️", "x": 92, "y": 52, "h": 14, "z": 1}}
      ],
      "events": [
        { "id": "stop.wait", "name": "Wait for the 7:42", "description": "Will it come? Nobody knows.", "unlock": [ { "type": "roomLevel", "room": "stop", "min": 2 } ],
          "cooldownSeconds": 120, "outcomes": [
            { "id": "late", "label": "Twenty minutes late", "weight": 60, "skillWeight": -2, "rewards": [ { "type": "coins", "seconds": 30 } ],
              "cinematic": { "type": "sequence", "frames": [ { "text": "7:42", "ms": 700 }, { "text": "7:50…", "ms": 700 }, { "text": "8:02…", "ms": 800 }, { "text": "🚌 finally", "ms": 1000 } ] } },
            { "id": "ontime", "label": "It came on time", "weight": 10, "skillWeight": 2, "rewards": [ { "type": "coins", "seconds": 300 }, { "type": "booster", "count": 1 } ],
              "cinematic": { "type": "sequence", "frames": [ { "text": "7:42", "ms": 700 }, { "text": "🚌", "ms": 700, "shake": true }, { "text": "ON TIME?!", "ms": 1200, "color": "#06d6a0" } ] } }
          ] }
      ] },
    { "id": "depot", "order": 2, "name": "The Depot", "blurb": "Where buses go to think about what they did.", "price": 1500, "baseIncome": 10,
      "background": { "color": "linear-gradient(#2b2d42 0 60%, #8d99ae 60%)" },
      "characters": [
        { "id": "depot.mechanic", "name": "Mechanic", "rarity": "common", "bio": "Can fix any bus with a wrench and a stern look. Mostly the look.", "sprite": { "char": "🧑‍🔧", "x": 25, "y": 92, "h": 28, "z": 4 } },
        { "id": "depot.driver", "name": "Veteran Driver", "rarity": "rare", "bio": "Thirty years on route 7. Waves at every other driver. They do not wave back.", "sprite": { "char": "🧑‍✈️", "x": 45, "y": 92, "h": 28, "z": 4 } },
        { "id": "depot.inspector", "name": "Ticket Inspector", "rarity": "epic", "bio": "Checks tickets with the calm of a judge and the speed of a glacier.", "sprite": { "char": "👮", "x": 88, "y": 92, "h": 28, "z": 4 } }
      ],
      "upgrades": [
        { "id": "depot.bus", "name": "Another Bus", "effect": "Same route, more buses.", "visual": { "char": "🚌", "x": 66, "y": 90, "h": 38, "z": 2 } },
        { "id": "depot.fuel", "name": "Fuel Pump", "effect": "Diesel, sadly.", "visual": { "char": "⛽", "x": 8, "y": 90, "h": 26, "z": 2 } },
        { "id": "depot.coffee", "name": "Coffee Machine", "effect": "Fuel for the drivers. Also diesel, sadly.", "visual": { "char": "☕", "x": 55, "y": 62, "h": 12, "z": 1}}
      ] }
  ]
}
