{
  "schemaVersion": 1,
  "id": "bus-empire",
  "name": "Bus Empire",
  "tagline": "Proof that the engine does not care what you build. Emoji art, no image files.",
  "currency": { "name": "Tickets", "symbol": "🎫" },
  "economy": {
    "startCoins": 20, "offlineCapHours": 12, "offlineRate": 1, "fullSetBonus": 1,
