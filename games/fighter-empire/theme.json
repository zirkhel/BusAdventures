{
  "schemaVersion": 1,
  "id": "fighter-empire",
  "name": "Fighter Empire",
  "tagline": "From a back alley to the big lights.",
  "currency": { "name": "Cash", "symbol": "$" },

  "economy": {
    "startCoins": 0,
    "offlineCapHours": 24,
    "offlineRate": 1,
    "fullSetBonus": 0.5,
    "roomLevel":      { "incomePerLevel": 0.25, "maxLevel": 25, "cost": { "seconds": 15, "growth": 1.33 }, "fragments": { "list": [1, 1, 1, 2, 2, 2, 3, 3, 3], "thenAdd": 1 } },
    "characterLevel": { "incomePerLevel": 0.6,  "maxLevel": 10, "cost": { "seconds": 30, "growth": 1.6 }, "fragments": { "list": [1, 3, 5, 10], "thenAdd": 5 } },
    "upgrade":        { "incomePerLevel": 0.15, "maxLevel": 10, "cost": { "seconds": 30, "growth": 1.5 }, "fragments": { "list": [1, 2, 3, 4, 6], "thenAdd": 2 } },
    "rarities": {
      "common": { "label": "Common", "incomeShare": 0.6, "unlockFragments": 2, "costFactor": 1,   "color": "#9aa4b2" },
      "rare":   { "label": "Rare",   "incomeShare": 1.2, "unlockFragments": 3, "costFactor": 1.5, "color": "#4da3ff" },
      "epic":   { "label": "Epic",   "incomeShare": 2.5, "unlockFragments": 5, "costFactor": 2.5, "color": "#c06bff" }
    }
  },

  "booster": {
    "name": "Fight Pack",
    "draws": 3,
    "priceSeconds": 30,
    "minPrice": 10,
    "slotWeights": { "character": 55, "room": 15, "upgrade": 20, "coins": 10 },
    "rarityWeights": { "common": 65, "rare": 27, "epic": 8 },
    "coinsSeconds": [15, 45],
    "epicPity": 12,
    "excludeMaxed": true
  },

  "prestige": {
    "name": "Rebrand",
    "description": "Sell the empire, keep the reputation. Everything earns more next time.",
    "startRooms": 3,
    "tiers": [
      { "requires": [ { "type": "roomLevel", "room": "thai", "min": 10 }, { "type": "charactersUnlocked", "room": "thai", "min": 2 } ], "incomeMultiplier": 2, "roomLimit": 4 },
      { "requires": [ { "type": "roomLevel", "room": "dojo", "min": 15 }, { "type": "charactersUnlocked", "room": "dojo", "min": 3 } ], "incomeMultiplier": 3, "roomLimit": 5 },
      { "requires": [ { "type": "roomLevel", "room": "arena", "min": 20 }, { "type": "charactersUnlocked", "room": "arena", "min": 3 } ], "incomeMultiplier": 4, "roomLimit": 5 }
    ]
  },

  "presentation": {
    "sceneAspect": 1.6,
    "palette": { "bg": "#0d0f14", "panel": "#171a22", "panel2": "#1f2330", "text": "#eef1f6", "muted": "#8a93a6", "accent": "#ff5a3c", "good": "#2ecc71" },
    "fontDisplay": "Impact, 'Arial Black', sans-serif"
  },

  "rooms": [
    {
