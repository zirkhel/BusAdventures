        { "id": "alley.knuckles", "name": "Knuckles Kowalski", "rarity": "rare", "role": "Fighter",
          "sprite": { "src": "assets/sprites/alley-knuckles.webp", "frames": 6, "fps": 7, "x": 36, "y": 93, "h": 42, "z": 4 } },
        { "id": "alley.ana", "name": "Alley Cat Ana", "rarity": "epic", "role": "Fighter",
