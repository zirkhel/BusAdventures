              "cinematic": { "type": "sequence", "frames": [ { "text": "DING DING", "ms": 700 }, { "text": "…", "ms": 600 }, { "text": "THUD.", "ms": 900, "shake": true }, { "text": "Out in round one.", "ms": 1200 } ] } },
            { "id": "third", "label": "Third place", "weight": 30, "skillWeight": 0,
