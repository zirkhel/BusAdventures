            { "id": "second", "label": "Runner-up", "weight": 20, "skillWeight": 1,
              "rewards": [ { "type": "coins", "seconds": 300 }, { "type": "fragments", "rarity": "common", "count": 1, "scope": "room" } ],
              "cinematic": { "type": "sequence", "frames": [ { "text": "DING DING", "ms": 700 }, { "text": "POW! POW!", "ms": 600, "shake": true }, { "text": "The final…", "ms": 900 }, { "text": "SO CLOSE.", "ms": 800 }, { "text": "SILVER", "ms": 1200, "color": "#c0c7d0" } ] } },
            { "id": "win", "label": "Champion of the alley", "weight": 10, "skillWeight": 2,
              "rewards": [ { "type": "coins", "seconds": 600 }, { "type": "fragments", "rarity": "rare", "count": 1, "scope": "room" }, { "type": "booster", "count": 1 } ],
              "cinematic": { "type": "sequence", "frames": [ { "text": "DING DING", "ms": 700 }, { "text": "POW!", "ms": 450, "shake": true }, { "text": "BAM!", "ms": 450, "shake": true }, { "text": "KNOCKOUT!", "ms": 900, "shake": true }, { "text": "CHAMPION", "ms": 1500, "color": "#f1c40f" } ] } }
          ]
        }
      ]
